
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="30"
             x:Class="Androidplayer.Pages.TitleBar"
             x:CompileBindings="False"
             Background="#2D2D30">

    <UserControl.Styles>
        <!-- Shared button base: no chrome, hover state -->
        <Style Selector="Button.titlebarBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Hover: light grey background, keep white foreground -->
        <Style Selector="Button.titlebarBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

        <!-- Pressed: slightly darker -->
        <Style Selector="Button.titlebarBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2C"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

        <!-- Close button hover: red -->
        <Style Selector="Button.titlebarClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.titlebarClose:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C50F1F"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#2D2D30" Height="30">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Icon and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Image Source="/Icons/android.png"
                       Height="25"
                       Margin="0,0,10,0"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <TextBlock Name="app_name"
                           Text="{Binding Title}"
                           Foreground="White"
                           FontSize="12"
                           PointerPressed="DragRegion_OnPointerPressed"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Drag Region -->
            <Border Grid.Column="1"
                    Background="Transparent"
                    PointerPressed="DragRegion_OnPointerPressed"/>

            <!-- Window Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <!-- Minimize -->
                <Button x:Name="MinimizeBtn"
                        Classes="titlebarBtn"
                        Content="─"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="MinimizeBtn_OnClick"/>

                <!-- Maximize / Restore -->
                <Button x:Name="MaximizeBtn"
                        Classes="titlebarBtn"
                        Content="☐"
                        FontSize="12"
                        Click="MaximizeBtn_OnClick"/>

                <!-- Close -->
                <Button x:Name="CloseBtn"
                        Classes="titlebarBtn titlebarClose"
                        Content="✕"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="CloseBtn_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>