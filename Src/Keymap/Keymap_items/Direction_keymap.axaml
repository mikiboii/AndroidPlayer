<UserControl x:Class="Androidplayer.Src.Keymap.Keymap_items.Direction_keymap"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="120">

  <UserControl.Styles>
    <!-- Remove button: base look -->
    <Style Selector="Button.removeBtn">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Background" Value="#FFE4C4"/>
      <Setter Property="BorderBrush" Value="#1A73E8"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransform" Value="scale(1.0)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Hover: scale up -->
    <Style Selector="Button.removeBtn:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.3)"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" IsHitTestVisible="True" Background="Transparent"
        PointerPressed="RootGrid_MouseLeftButtonDown"
        PointerMoved="RootGrid_MouseMove"
        PointerReleased="RootGrid_MouseLeftButtonUp">

    <Viewbox Stretch="Fill" Margin="5">
      <Grid>
        <Ellipse Stroke="#1A73E8"
                 StrokeThickness="2"
                 Width="95" Height="95"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <Canvas Width="100" Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

          <!-- W -->
          <Border Background="#635a4b" CornerRadius="15"
                  BorderBrush="#1A73E8" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="35" Canvas.Top="5">
            <TextBlock Text="W" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- A -->
          <Border Background="#635a4b" CornerRadius="15"
                  BorderBrush="#1A73E8" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="5" Canvas.Top="35">
            <TextBlock Text="A" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- D -->
          <Border Background="#635a4b" CornerRadius="15"
                  BorderBrush="#1A73E8" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="65" Canvas.Top="35">
            <TextBlock Text="D" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- S -->
          <Border Background="#635a4b" CornerRadius="15"
                  BorderBrush="#1A73E8" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="35" Canvas.Top="65">
            <TextBlock Text="S" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- Remove button -->
          <Button Classes="removeBtn"
                  Canvas.Left="72" Canvas.Top="10"
                  Click="remove_btn_OnClick">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        RenderTransformOrigin="0.5,0.5">
                  <TextBlock Text="X" Foreground="Red"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>

        </Canvas>
      </Grid>
    </Viewbox>

    <!-- Dashed outline -->
    <Rectangle x:Name="DashedBorder"
               Stroke="#1A73E8"
               StrokeThickness="2"
               StrokeDashArray="4,2"
               RadiusX="8" RadiusY="8"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

    <!-- Resize thumbs -->
    <primitives:Thumb x:Name="TopLeftThumb" Width="10" Height="10"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Cursor="TopLeftCorner"
                      DragDelta="ResizeThumb_DragDelta">
      <primitives:Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Rectangle Fill="#1A73E8"/>
        </ControlTemplate>
      </primitives:Thumb.Template>
    </primitives:Thumb>

    <primitives:Thumb x:Name="TopRightThumb" Width="10" Height="10"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Cursor="TopRightCorner"
                      DragDelta="ResizeThumb_DragDelta">
      <primitives:Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Rectangle Fill="#1A73E8"/>
        </ControlTemplate>
      </primitives:Thumb.Template>
    </primitives:Thumb>

    <primitives:Thumb x:Name="BottomLeftThumb" Width="10" Height="10"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Cursor="TopRightCorner"
                      DragDelta="ResizeThumb_DragDelta">
      <primitives:Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Rectangle Fill="#1A73E8"/>
        </ControlTemplate>
      </primitives:Thumb.Template>
    </primitives:Thumb>

    <primitives:Thumb x:Name="BottomRightThumb" Width="10" Height="10"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Cursor="TopLeftCorner"
                      DragDelta="ResizeThumb_DragDelta">
      <primitives:Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Rectangle Fill="#1A73E8"/>
        </ControlTemplate>
      </primitives:Thumb.Template>
    </primitives:Thumb>

  </Grid>
</UserControl>