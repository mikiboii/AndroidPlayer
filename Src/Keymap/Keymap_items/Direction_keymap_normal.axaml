<UserControl x:Class="Androidplayer.Src.Keymap.Keymap_items.Direction_keymap_normal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsHitTestVisible="False"
             d:DesignHeight="120" d:DesignWidth="120">

  <Grid x:Name="RootGrid" IsHitTestVisible="True" Background="Transparent">

    <Viewbox Stretch="Fill" Margin="5">
      <Grid>
        <!-- Circular main border (commented out in original) -->

        <Canvas Width="100" Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

          <!-- W (Top) -->
          <Border Background="#AC3C4146" CornerRadius="15"
                  BorderBrush="#6B7583" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="35" Canvas.Top="5">
            <TextBlock Text="W" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- A (Left) -->
          <Border Background="#AC3C4146" CornerRadius="15"
                  BorderBrush="#6B7583" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="5" Canvas.Top="35">
            <TextBlock Text="A" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- D (Right) -->
          <Border Background="#AC3C4146" CornerRadius="15"
                  BorderBrush="#6B7583" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="65" Canvas.Top="35">
            <TextBlock Text="D" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

          <!-- S (Bottom) -->
          <Border Background="#AC3C4146" CornerRadius="15"
                  BorderBrush="#6B7583" BorderThickness="2"
                  Width="30" Height="30"
                  Canvas.Left="35" Canvas.Top="65">
            <TextBlock Text="S" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>

        </Canvas>
      </Grid>
    </Viewbox>

  </Grid>
</UserControl>