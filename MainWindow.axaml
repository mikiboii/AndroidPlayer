<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="using:Androidplayer.Pages"
        
        xmlns:local="using:Androidplayer"
        
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Androidplayer.MainWindow"
        
        
        
        
        
        
        CanResize="True"

        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        
        Background="Black"
        Title="Androidplayer">
    
        
         <Grid RowDefinitions="40,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

             <pages:TitleBar Grid.Row="0"   x:Name="AppTitleBar" ParentWindow="{Binding $parent[Window]}" ></pages:TitleBar>
             
             <Grid Grid.Row="1" Margin="4">
             
                  <local:FlyleafHost  x:Name="AndroidVideo" d:DesignWidth="500" d:DesignHeight="500"  >
                      
                      <Grid>
                 
                 
                 
                 <Button Content="click"  Width="50" Height="30" Background="Aqua" Click="Button_OnClick" ></Button>
                      </Grid>
                 
                 
                 
