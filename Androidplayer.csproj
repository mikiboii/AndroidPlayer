<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>12.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

<!--        <PublishAot>true</PublishAot>-->
<!--        <IsAotCompatible>true</IsAotCompatible>-->
<!--        <SelfContained>true</SelfContained>-->
        
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.6" />
        <PackageReference Include="Avalonia.Desktop" Version="11.2.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.6" />
        
<!--        <PackageReference Include="Avalonia.Diagnostics" Version="11.2.6">-->
<!--            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>-->
<!--            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>-->
<!--        </PackageReference>-->
        
        
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" />

        <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.6" />
        <PackageReference Include="LiteDB" Version="6.0.0-prerelease.65" />
        <PackageReference Include="SharpAdbClient" Version="2.3.23" />
        <PackageReference Include="SharpDX" Version="4.2.0" />
        <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
        <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
        <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
        <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
        <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
        <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
        <PackageReference Include="SharpDX.XAudio2" Version="4.2.0" />
        <PackageReference Include="Silk.NET" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
        <PackageReference Include="Silk.NET.DXVK.Native" Version="2.23.0" />
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
        <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    </ItemGroup>

    <!-- ============================================================ -->
    <!--  Trimmer roots — required for Native AOT with reflection-    -->
    <!--  heavy dependencies. Each of these libraries uses reflection -->
    <!--  or Activator.CreateInstance internally, which the trimmer   -->
    <!--  cannot statically analyze. Preserving them keeps the        -->
    <!--  constructors and types alive at runtime.                    -->
    <!-- ============================================================ -->
    <ItemGroup>
        <!-- SharpDX: uses a generic factory pattern (CppObject.FromPointer<T>) -->
        <!-- that trims away the T constructors if not rooted. Without these, -->
        <!-- you get MissingMethodException on Texture2D, SwapChain, Device, -->
        <!-- VideoProcessor, etc. -->
        <TrimmerRootAssembly Include="SharpDX" />
        <TrimmerRootAssembly Include="SharpDX.Direct3D11" />
        <TrimmerRootAssembly Include="SharpDX.Direct3D9" />
        <TrimmerRootAssembly Include="SharpDX.DXGI" />
        <TrimmerRootAssembly Include="SharpDX.D3DCompiler" />
        <TrimmerRootAssembly Include="SharpDX.Direct2D1" />
        <TrimmerRootAssembly Include="SharpDX.Mathematics" />
        <TrimmerRootAssembly Include="SharpDX.XAudio2" />

        <!-- LiteDB: uses Reflection.Emit and dynamic LINQ expression -->
        <!-- compilation. AOT can't support Reflection.Emit at all, so    -->
        <!-- if you still see failures after this, LiteDB may not work    -->
        <!-- under Native AOT and you'd need to switch to a JSON or       -->
        <!-- SQLite-based store instead.                                  -->
        <TrimmerRootAssembly Include="LiteDB" />

        <!-- System.Configuration: uses Activator.CreateInstance with -->
        <!-- reflection to build section handlers. Required unless you -->
        <!-- remove the dependency entirely.                           -->
        <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />

        <!-- SharpAdbClient: uses reflection for XML parsing of ADB -->
        <!-- responses and for the device list.                    -->
        <TrimmerRootAssembly Include="SharpAdbClient" />

        <!-- FFmpeg.AutoGen: uses reflection to resolve native entry -->
        <!-- points on some platforms.                              -->
        <TrimmerRootAssembly Include="FFmpeg.AutoGen" />

        <!-- LibVLCSharp: uses reflection to bind to native LibVLC -->
        <!-- entry points and to construct MediaPlayer types.     -->
        <TrimmerRootAssembly Include="LibVLCSharp" />
        <TrimmerRootAssembly Include="LibVLCSharp.Avalonia" />

        
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Icons\**" />
        <AvaloniaResource Include="Src\Keymap\K_icons\**" />
        <AvaloniaResource Include="android.png" Condition="Exists('android.png')" />
    </ItemGroup>
</Project>