<UserControl x:Class="Androidplayer.windows.settings_view.AboutSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Androidplayer.windows.settings_view"
             xmlns:windows="clr-namespace:Androidplayer.windows"

             x:DataType="windows:UISettings"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="500">

  <!-- Scrollable content card -->
  <Border Background="White"
          CornerRadius="8"
          Padding="24"
          Margin="0,0,0,12"
          BorderBrush="#E8EBF0"
          BorderThickness="1">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ===== App Hero Card ===== -->
        <Border CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16"
                BorderBrush="#E6E9EE"
                BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#F5F9FF" Offset="0"/>
              <GradientStop Color="#FFFFFF" Offset="0.6"/>
              <GradientStop Color="#F0F7FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App Icon -->
            <Border Grid.Column="0"
                    Width="64" Height="64"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E6E9EE"
                    BorderThickness="1"
                    Margin="0,0,16,0"
                    BoxShadow="0 2 8 0 #15000000">
              <Image Source="/Icons/android.png"
                     Width="40" Height="40"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Border>

            <!-- App Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="AndroidPlayer"
                         FontWeight="Bold"
                         FontSize="20"
                         Foreground="#1A1D21"/>

              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Background="#E8F0FE"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,0,6,0">
                  <TextBlock Text="v1.0.0"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#2B6CB0"/>
                </Border>
                <Border Background="#E6F7EC"
                        CornerRadius="4"
                        Padding="6,2">
                  <TextBlock Text="Open Source"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#2F855A"/>
                </Border>
              </StackPanel>

              <TextBlock Text="Screen mirroring for Android, made simple."
                         FontSize="12"
                         Foreground="#6B6F77"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===== About Card ===== -->
        <Border CornerRadius="6"
                Background="#FFFFFF"
                Padding="14"
                Margin="0,0,0,16"
                BorderBrush="#EEF1F4"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource PrimaryBrush}"
                       Text="About"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0,0,0,4"/>
            <TextBlock Text="What is AndroidPlayer?"
                       FontSize="12"
                       Foreground="#6B6F77"
                       Margin="0,0,0,10"/>

            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#26292D"
                       LineHeight="20">
              AndroidPlayer is a lightweight, open-source screen mirroring
              application that lets you view and control your Android device
              from your PC. Built with performance and simplicity in mind,
              it supports both native window overlay and GPU interop rendering
              modes, with fully customizable resolution, frame rate, bitrate,
              and audio options.
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- ===== Feature Highlights ===== -->
        <Border CornerRadius="6"
                Background="#FFFFFF"
                Padding="14"
                Margin="0,0,0,16"
                BorderBrush="#EEF1F4"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource PrimaryBrush}"
                       Text="Highlights"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0,0,0,10"/>

            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Low-latency screen mirroring"
                           FontSize="13" Foreground="#26292D" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎛️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Native &amp; GPU interop rendering modes"
                           FontSize="13" Foreground="#26292D" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔊" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Audio forwarding support"
                           FontSize="13" Foreground="#26292D" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🧩" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Custom resolution, FPS &amp; bitrate"
                           FontSize="13" Foreground="#26292D" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== Links Card ===== -->
        <Border CornerRadius="6"
                Background="#FFFFFF"
                Padding="14"
                Margin="0,0,0,16"
                BorderBrush="#EEF1F4"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource PrimaryBrush}"
                       Text="Project Links"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0,0,0,10"/>

            <StackPanel Spacing="6">
              <Button x:Name="GithubButton"
                      Classes="RoundedButton"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Height="34"
                      Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🐙" FontSize="14" Margin="0,0,10,0"/>
                  <TextBlock Text="View on GitHub" FontSize="13"/>
                </StackPanel>
              </Button>

              <Button x:Name="IssuesButton"
                      Classes="RoundedButton"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Height="34"
                      Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🐞" FontSize="14" Margin="0,0,10,0"/>
                  <TextBlock Text="Report an issue" FontSize="13"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== Donation Card (Highlighted) ===== -->
        <Border CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#C9DDFF"
                BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#F5F9FF" Offset="0"/>
              <GradientStop Color="#EAF3FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>

          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="💙" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Support This Project"
                         FontWeight="Bold"
                         FontSize="15"
                         Foreground="#1A1D21"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#4A5568"
                       LineHeight="20"
                       Margin="0,0,0,12">
              AndroidPlayer is completely free and open source, built with love in
              spare time. If it makes your life easier, please consider supporting
              its development — every contribution, big or small, keeps the
              project alive and growing. 💖
            </TextBlock>

            <Button x:Name="PayPalButton"
                    Classes="RoundedPrimaryButton"
                    Width="180" Height="38"
                    HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💳" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Donate via PayPal" FontSize="13" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- ===== Footer / Credits ===== -->
        <Border CornerRadius="6"
                Background="#FAFBFC"
                Padding="14"
                BorderBrush="#EEF1F4"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Made with ❤️ by mikiboii"
                       FontSize="12"
                       Foreground="#6B6F77"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>

            <TextBlock Text="© 2024 AndroidPlayer · Apache License"
                       FontSize="11"
                       Foreground="#9AA1AA"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"
                       TextAlignment="Center"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>