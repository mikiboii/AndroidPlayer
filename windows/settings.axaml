

<Window x:Class="Androidplayer.windows.settings"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Androidplayer.windows"
        xmlns:settings_view="clr-namespace:Androidplayer.windows.settings_view"
        xmlns:windows="clr-namespace:Androidplayer.windows"

        x:DataType="windows:UISettings"

        mc:Ignorable="d"
        Title="Settings"
        Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="Transparent"

        Icon="/Icons/android.png"

        CornerRadius="8"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <!-- Background="#F6F7F9" -->
  
  <Border CornerRadius="8"
          ClipToBounds="True"
          Background="#F6F7F9"
          BorderBrush="#E6E9EE"
          BorderThickness="1">

  

  
  <Grid Margin="0"
        
        Background="#F6F7F9"
        
        >

    <!-- ===== Main layout (unchanged) ===== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Navigation Panel -->
      <Border Grid.Column="0"
            
              Background="White"
              CornerRadius="8"
              Padding="12"
              Margin="12,2,0,0">
        <StackPanel>
          
          <Border
            BorderThickness="2"
            BorderBrush="Transparent"
            Background="Transparent"
            Margin="-10,-10,-10,0"
            Padding="0,13,0,5"
            PointerPressed="TopBar_MouseLeftButtonDown"
            >
            
            <TextBlock Text="Settings"
                       FontWeight="Bold"
                       FontSize="18"
                       Margin="6,4,0,18"/>
          </Border>
          <ListBox x:Name="SettingsListBox"
                   BorderThickness="0"
                   Background="Transparent"
                   SelectionMode="Single"
                   SelectedIndex="0"
                   FontSize="14"
                   Foreground="#2D2D2D">
            <ListBoxItem Padding="10" CornerRadius="4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📺" Margin="0,0,10,0"/>
                <TextBlock Text="Screen Settings"/>
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem Padding="10"  CornerRadius="4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🪟" Margin="0,0,10,0"/>
                <TextBlock Text="Window settings"/>
              </StackPanel>
            </ListBoxItem>

            <!-- <ListBoxItem Padding="10" CornerRadius="4" Background="#F2F6FF" FontWeight="SemiBold"> -->
            <!--   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"> -->
            <!--     <TextBlock Text="🖱️" Margin="0,0,10,0"/> -->
            <!--     <TextBlock Text="Mouse Setting"/> -->
            <!--   </StackPanel> -->
            <!-- </ListBoxItem> -->
            
            <ListBoxItem Padding="10" CornerRadius="4" Background="#F2F6FF" FontWeight="SemiBold">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16" Margin="-3,0,10,0">
                  <Path Fill="#2D2D2D"
                        Data="M12 2C8.13 2 5 5.13 5 9v6c0 3.87 3.13 7 7 7s7-3.13 7-7V9c0-3.87-3.13-7-7-7zm0 2c2.76 0 5 2.24 5 5v1h-5V4zm-5 5c0-2.76 2.24-5 5-5v6H7V9zm0 5v-3h5v8c-2.76 0-5-2.24-5-5zm7 5v-8h5v3c0 2.76-2.24 5-5 5z"/>
                </Viewbox>
                <TextBlock Text="Mouse Setting"/>
              </StackPanel>
            </ListBoxItem>

            <!-- <ListBoxItem Padding="10"  CornerRadius="4"> -->
            <!--   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"> -->
            <!--     <TextBlock Text="⌨️" Margin="0,0,10,0"/> -->
            <!--     <TextBlock Text="Shortcut key"/> -->
            <!--   </StackPanel> -->
            <!-- </ListBoxItem> -->
            
            <ListBoxItem Padding="10" CornerRadius="4">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ℹ️" Margin="0,0,10,0"/>
                <TextBlock Text="About"/>
              </StackPanel>
            </ListBoxItem>
            
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Separator -->
      <Border Grid.Column="1" Width="1" Background="#E6E9EE" Margin="0,10"/>

      <!-- Main content area -->
      <Grid Grid.Column="2" Margin="0,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Top bar with close button -->
        <Grid Grid.Row="0" Margin="0,0,0,8" Height="50" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
        
          <Border Grid.Column="0"
                  BorderBrush="#E6E9EE"
                  BorderThickness="0,0,0,3"
                  Background="Transparent"
                  PointerPressed="TopBar_MouseLeftButtonDown">
            <Image Source="/Icons/close.png"
                   Margin="0,12,12,0"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Width="22" Height="22"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Cursor="Hand"
                   PointerReleased="CloseButton_Click"
                   IsHitTestVisible="True"/>
          </Border>
        </Grid>
        
        
        
        <!-- Top bar with drag region + close button -->
       
        <!-- Main content area -->
        <ContentControl x:Name="SettingsContent" Grid.Row="1" Margin="0,0,0,12"/>

        <!-- Footer with Cancel + Save aligned to the right -->
        <Border Grid.Row="2" Background="Transparent">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0">
              <Button Content="Cancel"
                      Classes="RoundedButton"
                      Width="100" Height="34" Margin="0,0,10,0"
                      Click="CloseButton_Click"/>
              <Button Content="Save Changes"
                      Classes="RoundedPrimaryButton"
                      Width="130" Height="34"
                      Click="save_btn_click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Toast overlay (floats above everything) ===== -->
    <!-- <Border x:Name="ToastMessage" -->
    <!--         IsHitTestVisible="False" -->
    <!--         Background="#DD333333" -->
    <!--         CornerRadius="8" -->
    <!--         Padding="10,8" -->
    <!--         HorizontalAlignment="Center" -->
    <!--         VerticalAlignment="Top" -->
    <!--         Margin="0,20,0,0" -->
    <!--         Opacity="0" -->
    <!--         MaxWidth="400"> -->
    <!--   <Grid> -->
    <!--     <Grid.ColumnDefinitions> -->
    <!--       <ColumnDefinition Width="Auto"/> -->
    <!--       <ColumnDefinition Width="*"/> -->
    <!--     </Grid.ColumnDefinitions> -->
    <!-- -->
    <!--     <Image x:Name="Toasticon" -->
    <!--            Source="/Icons/warning.png" -->
    <!--            RenderOptions.BitmapInterpolationMode="HighQuality" -->
    <!--            Width="30" Height="30" -->
    <!--            VerticalAlignment="Top" -->
    <!--            Margin="0,0,8,0"/> -->
    <!-- -->
    <!--     <TextBlock x:Name="ToastText" -->
    <!--                Grid.Column="1" -->
    <!--                Text="Saved successfully!" -->
    <!--                Foreground="White" -->
    <!--                FontWeight="SemiBold" -->
    <!--                TextWrapping="Wrap" -->
    <!--                VerticalAlignment="Top"/> -->
    <!--   </Grid> -->
    <!-- </Border> -->
    <!-- -->
    
    
    
    <!-- ===== Toast overlay (floats above everything) ===== -->
    <Border x:Name="ToastMessage"
            IsHitTestVisible="False"
            Background="White"
            BorderBrush="#E6E9EE"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,20,0,0"
            Opacity="0"
            MaxWidth="420"
            BoxShadow="0 4 16 0 #22000000">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="Toasticon"
               Source="/Icons/warning.png"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Width="20" Height="20"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

        <TextBlock x:Name="ToastText"
                   Grid.Column="1"
                   Text="Saved successfully!"
                   Foreground="#2D2D2D"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
    
    
    
    
  </Grid>
    
  </Border>
</Window>